{
  "name": "server",
  "version": "0.0.0-dev",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "compile": "bun build ./src/index.ts --compile --outfile ./dist/backend.bin",
    "check": "bun check",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@azure/identity": "~4.14.1",
    "@hono/valibot-validator": "catalog:",
    "@microsoft/msgraph-sdk": "1.0.0-preview.92",
    "@microsoft/msgraph-sdk-core": "1.0.0-preview.17",
    "@microsoft/msgraph-sdk-organization": "1.0.0-preview.92",
    "@microsoft/msgraph-sdk-users": "1.0.0-preview.92",
    "@serkonda7/conex-device-schema": "workspace:*",
    "better-result": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "shared": "workspace:*",
    "tanss-api": "~0.4.0",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  }
}
