{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": ["apps/**/*", "packages/**/*", "!**/dist/**", "!**/node_modules/**"]
  }
}
