{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/*.md", "!**/*.svg", "!server/drizzle"]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noVar": "error",
        "noShadow": "error",
        "noReturnAssign": "error",
        "noEvolvingTypes": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "useDomQuerySelector": "error",
        "noDescendingSpecificity": "off"
      },
      "nursery": {
        "useExplicitType": "error" // TODO implicit objects in function params are not caught
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "quoteStyle": "single"
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  }
}
