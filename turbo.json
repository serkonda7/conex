{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "start": {
      "dependsOn": ["^build", "db:migrate"],
      "cache": false,
      "persistent": true
    },
    "api#start": {
      "dependsOn": ["db:migrate"]
    }
  }
}
