# Copy to .env and adjust
POSTGRES_USER=conex
POSTGRES_PASSWORD=conex
POSTGRES_DB=conex
POSTGRES_PORT=5432

DATABASE_URL=postgres://conex:conex@localhost:5432/conex

API_PORT=3001
WEB_PORT=5173
PORT=3001

BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001

VITE_API_URL=http://localhost:3001

# LDAP bridge for Agfeo TK (apps/ldap). Container listens on 1389,
# exposed on the host as 389 (LDAP_PORT) so the TK uses standard port 389.
LDAP_BASE_DN=dc=conex,dc=local
LDAP_BIND_DN=cn=admin,dc=conex,dc=local
LDAP_BIND_PASSWORD=secret
LDAP_ALLOW_ANONYMOUS=true
LDAP_SIZE_LIMIT=50
LDAP_PORT=389
LDAP_HTTP_PORT=3002
# LDAP_MOCK_FILE=./demo-contacts.json
